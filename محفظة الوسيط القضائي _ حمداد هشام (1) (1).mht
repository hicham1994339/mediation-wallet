            <div class="document">

              <div class="document-info">

                <div class="doc-icon">📋</div>

                <div>
                  <strong>محضر الجلسة الأولى.pdf</strong>
                  <small>القضية 2026/00125</small>
                </div>

              </div>

              <button class="btn light">
                عرض
              </button>

            </div>


            <div class="document">

              <div class="document-info">

                <div class="doc-icon">🤝</div>

                <div>
                  <strong>محضر اتفاق تجريبي.pdf</strong>
                  <small>القضية 2026/00131</small>
                </div>

              </div>

              <button class="btn light">
                عرض
              </button>

            </div>

          </div>

        </div>

      </div>


