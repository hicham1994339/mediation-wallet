.full { width: 100%; }

.app { min-height: 100vh; }

.sidebar { position: fixed; right: 0px; top: 0px; bottom: 0px; width: 275px; background: linear-gradient(rgb(9, 43, 68), rgb(13, 64, 87)); color: rgb(255, 255, 255); z-index: 50; overflow-y: auto; }

.brand { text-align: center; padding: 25px 18px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }

.brand-logo { width: 65px; height: 65px; margin: auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgb(255, 255, 255); color: var(--navy); font-size: 30px; border: 3px solid var(--gold); }

.brand h2 { font-size: 17px; margin: 12px 0px 4px; }

.brand small { color: rgb(191, 208, 216); }

.nav { padding: 15px; }

.nav button { display: block; width: 100%; border: 0px; color: rgb(220, 232, 237); background: transparent; text-align: right; padding: 13px 15px; border-radius: 10px; margin-bottom: 5px; }

.nav button:hover, .nav button.active { background: rgba(255, 255, 255, 0.12); color: rgb(255, 255, 255); }

.nav .separator { height: 1px; background: rgba(255, 255, 255, 0.1); margin: 14px 5px; }

.main { margin-right: 275px; }

.topbar { height: 75px; background: rgb(255, 255, 255); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; padding: 0px 30px; position: sticky; top: 0px; z-index: 30; }

.top-title { font-weight: bold; color: var(--navy); }

.user { display: flex; align-items: center; gap: 10px; }

.avatar { width: 42px; height: 42px; border-radius: 50%; display: flex; justify-content: center; align-items: center; background: var(--navy); color: rgb(255, 255, 255); font-weight: bold; }

.content { padding: 30px; }

.page { display: none; }

.page.active { display: block; }

.page-title { margin-bottom: 25px; }

.page-title h1 { color: var(--navy); margin: 0px 0px 7px; font-size: 27px; }

.page-title p { margin: 0px; color: var(--muted); }

.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; margin-bottom: 22px; }

.stat { background: rgb(255, 255, 255); border-radius: 15px; padding: 20px; box-shadow: var(--shadow); border-right: 4px solid var(--blue); }

.stat-icon { font-size: 25px; }

.stat strong { display: block; font-size: 29px; color: var(--navy); margin: 8px 0px 3px; }

.stat span { color: var(--muted); font-size: 13px; }

.panel { background: rgb(255, 255, 255); border-radius: 16px; box-shadow: var(--shadow); padding: 22px; margin-bottom: 22px; }

.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 18px; }

.panel-head h2 { margin: 0px; font-size: 19px; color: var(--navy); }

.table-scroll { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; min-width: 850px; }

th, td { padding: 13px; border-bottom: 1px solid var(--border); text-align: right; }

th { background: rgb(244, 247, 249); color: var(--navy); font-size: 13px; }

td { font-size: 13px; }

tr:hover td { background: rgb(251, 253, 254); }

.badge { display: inline-block; border-radius: 30px; padding: 5px 10px; font-size: 11px; font-weight: bold; }

.running { background: rgb(229, 245, 238); color: rgb(8, 115, 77); }

.agreement { background: rgb(229, 240, 250); color: rgb(23, 92, 138); }

.failed { background: rgb(253, 234, 234); color: rgb(161, 38, 38); }

.closed { background: rgb(237, 240, 242); color: rgb(93, 107, 115); }

.pending { background: rgb(255, 242, 220); color: rgb(154, 91, 10); }

.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }

.search { flex: 1 1 0%; min-width: 220px; border: 1px solid var(--border); border-radius: 10px; padding: 11px; }

.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }

.full-col { grid-column: 1 / -1; }

.actions { display: flex; flex-wrap: wrap; gap: 8px; }

.details-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

.detail { background: rgb(246, 248, 250); padding: 14px; border-radius: 10px; }

.detail small { display: block; color: var(--muted); margin-bottom: 4px; }

.timeline { border-right: 3px solid var(--blue); padding-right: 20px; }

.timeline-item { position: relative; margin-bottom: 22px; }

.timeline-item::before { content: ""; position: absolute; right: -27px; top: 4px; width: 11px; height: 11px; border-radius: 50%; background: var(--blue); }

.timeline-item strong { color: var(--navy); }

.timeline-item small { display: block; color: var(--muted); margin-top: 4px; }

.document { display: flex; justify-content: space-between; align-items: center; padding: 14px; border: 1px solid var(--border); border-radius: 11px; margin-bottom: 9px; }

.document-info { display: flex; gap: 10px; align-items: center; }

.doc-icon { width: 38px; height: 38px; border-radius: 9px; background: rgb(237, 245, 248); display: flex; align-items: center; justify-content: center; }

.modal { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.58); display: none; justify-content: center; align-items: center; padding: 20px; z-index: 100; }

.modal.show { display: flex; }

.modal-box { background: rgb(255, 255, 255); width: 100%; max-width: 900px; max-height: 92vh; overflow: auto; border-radius: 18px; padding: 25px; }

.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }

.close { width: 38px; height: 38px; border: 0px; border-radius: 50%; background: rgb(238, 242, 244); font-size: 21px; }

.hero { background: linear-gradient(120deg, rgba(9, 43, 68, 0.96), rgba(18, 103, 130, 0.94)); color: rgb(255, 255, 255); border-radius: 18px; padding: 35px; margin-bottom: 22px; }

.hero h2 { margin-top: 0px; font-size: 27px; }

.hero p { line-height: 2; color: rgb(217, 232, 238); max-width: 850px; }

.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.feature { background: rgb(255, 255, 255); padding: 20px; border-radius: 14px; box-shadow: var(--shadow); }

.feature-icon { font-size: 28px; }

.feature h3 { color: var(--navy); }

.notice { padding: 15px; border-bottom: 1px solid var(--border); }

.notice:last-child { border: 0px; }

.notice small { display: block; color: var(--muted); margin-top: 5px; }

.mobile-btn { display: none; border: 0px; border-radius: 8px; background: var(--navy); color: rgb(255, 255, 255); padding: 8px 11px; }

@media (max-width: 1050px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
  .features { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 750px) {
  .sidebar { transform: translateX(100%); transition: 0.25s; }
  .sidebar.open { transform: translateX(0px); }
  .main { margin-right: 0px; }
  .mobile-btn { display: block; }
  .topbar { padding: 0px 15px; }
  .content { padding: 18px; }
  .stats { grid-template-columns: 1fr; }
  .form-grid, .details-grid, .features { grid-template-columns: 1fr; }
  .login-card { padding: 25px; }
}
