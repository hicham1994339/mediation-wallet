    تم الاتفاق
  </span></td>

        <td>
          <button class="btn light">
            عرض
          </button>
        </td>

      </tr>

    

      <tr>

        <td>2026/00125</td>

        <td>محكمة ورقلة</td>

        <td>الأستاذ محمد أحمد</td>

        <td>نزاع مدني حول تنفيذ التزام</td>

        <td><span class="badge running">
