    <div class="field">
      <label>اسم المستخدم</label>
      <input id="username" placeholder="أدخل اسم المستخدم">
    </div>

    <div class="field">
      <label>كلمة المرور</label>
      <input id="password" type="password" placeholder="أدخل كلمة المرور">
    </div>

    <button class="btn primary full">
      🔐 دخول إلى المحفظة
