              </thead>

              <tbody id="caseTable"></tbody>

            </table>

          </div>

        </div>

      </div>


      <!-- ================= DOCUMENTS ================= -->

      <div class="page" id="documents">

        <div class="page-title">

          <h1>مركز الوثائق</h1>

          <p>
            نموذج تجريبي لتنظيم الوثائق المرتبطة بملفات الوساطة.
          </p>

        </div>

        <div class="panel">

          <div class="panel-head">

            <h2>الوثائق التجريبية</h2>

            <button class="btn secondary">
