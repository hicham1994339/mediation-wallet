    في الانتظار
  </span></td>

        <td>
          <button class="btn light">
            عرض
          </button>
        </td>

      </tr>

    

      <tr>

        <td>2026/00131</td>

        <td>محكمة الأغواط</td>

        <td>الأستاذة فاطمة ز.</td>

